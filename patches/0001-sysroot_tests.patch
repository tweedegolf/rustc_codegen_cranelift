From 86743bd1ce3a5e3ef72b528ef8d14646e057187a Mon Sep 17 00:00:00 2001
From: bjorn3 <17426603+bjorn3@users.noreply.github.com>
Date: Tue, 8 Sep 2026 15:04:20 +0200
Subject: [PATCH] foo

---
 alloctests/Cargo.toml     |  1 +
 alloctests/benches/lib.rs |  1 +
 alloctests/foo/Cargo.toml | 15 +++++++++++++++
 alloctests/foo/lib.rs     |  2 ++
 alloctests/lib.rs         |  2 ++
 alloctests/tests/lib.rs   |  1 +
 6 files changed, 22 insertions(+)
 create mode 100644 alloctests/foo/Cargo.toml
 create mode 100644 alloctests/foo/lib.rs

diff --git a/Cargo.lock b/Cargo.lock
index 4609065..86aadc6 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -34,6 +34,7 @@ dependencies = [
 name = "alloctests"
 version = "0.0.0"
 dependencies = [
+ "foo",
  "rand",
  "rand_xorshift",
 ]
@@ -101,6 +102,14 @@ version = "0.2.0"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "77ce24cb58228fbb8aa041425bb1050850ac19177686ea6e0f41a70416f56fdb"
 
+[[package]]
+name = "foo"
+version = "0.0.0"
+dependencies = [
+ "rand",
+ "rand_xorshift",
+]
+
 [[package]]
 name = "fortanix-sgx-abi"
 version = "0.6.1"
diff --git a/alloctests/Cargo.toml b/alloctests/Cargo.toml
index 791b8ec..39f896b 100644
--- a/alloctests/Cargo.toml
+++ b/alloctests/Cargo.toml
@@ -17,6 +17,7 @@ doc = false
 [dev-dependencies]
 rand = { version = "0.9.0", default-features = false, features = ["alloc"] }
 rand_xorshift = "0.4.0"
+foo = { path = "foo" }
 
 [[test]]
 name = "alloctests"
diff --git a/alloctests/benches/lib.rs b/alloctests/benches/lib.rs
index 336e836..c4e157f 100644
--- a/alloctests/benches/lib.rs
+++ b/alloctests/benches/lib.rs
@@ -10,6 +10,7 @@
 #![deny(implicit_provenance_casts)]
 
 extern crate test;
+extern crate foo;
 
 mod binary_heap;
 mod btree;
diff --git a/alloctests/foo/Cargo.toml b/alloctests/foo/Cargo.toml
new file mode 100644
index 0000000..ab273c3
--- /dev/null
+++ b/alloctests/foo/Cargo.toml
@@ -0,0 +1,15 @@
+[package]
+name = "foo"
+version = "0.0.0"
+edition = "2024"
+
+[lib]
+path = "lib.rs"
+test = true
+bench = true
+doc = false
+crate-type = ["dylib"]
+
+[dependencies]
+rand = { version = "0.9.0", default-features = false, features = ["alloc"] }
+rand_xorshift = "0.4.0"
diff --git a/alloctests/foo/lib.rs b/alloctests/foo/lib.rs
new file mode 100644
index 0000000..855f8a6
--- /dev/null
+++ b/alloctests/foo/lib.rs
@@ -0,0 +1,4 @@
+#![feature(test)]
+extern crate rand;
+extern crate rand_xorshift;
+extern crate test;
diff --git a/alloctests/lib.rs b/alloctests/lib.rs
index 77e56d3..face505 100644
--- a/alloctests/lib.rs
+++ b/alloctests/lib.rs
@@ -80,6 +80,8 @@ extern crate std;
 #[allow(unused_imports)]
 use std::prelude::rust_2024::*;
 
+extern crate foo;
+
 #[cfg(test)]
 extern crate test;
 mod testing;
diff --git a/alloctests/tests/lib.rs b/alloctests/tests/lib.rs
index b2a3e8f..7f21abf 100644
--- a/alloctests/tests/lib.rs
+++ b/alloctests/tests/lib.rs
@@ -65,6 +65,7 @@
 // tidy-alphabetical-end
 
 extern crate alloc;
+extern crate foo;
 
 use std::hash::{DefaultHasher, Hash, Hasher};
 
diff --git a/alloctests/tests/c_str_alloc_error.rs b/alloctests/tests/c_str_alloc_error.rs
index 669a783..d2539a5 100644
--- a/alloctests/tests/c_str_alloc_error.rs
+++ b/alloctests/tests/c_str_alloc_error.rs
@@ -14,6 +14,8 @@
 #![cfg(not(all(miri, windows)))]
 #![feature(alloc_error_hook)]
 
+extern crate foo;
+
 use std::alloc::{GlobalAlloc, Layout, System, set_alloc_error_hook};
 use std::cell::Cell;
 use std::ffi::CString;
diff --git a/alloctests/tests/vec_deque_alloc_error.rs b/alloctests/tests/vec_deque_alloc_error.rs
index 21a9118..866375d 100644
--- a/alloctests/tests/vec_deque_alloc_error.rs
+++ b/alloctests/tests/vec_deque_alloc_error.rs
@@ -1,5 +1,7 @@
 #![feature(alloc_error_hook, allocator_ext)]
 
+extern crate foo;
+
 use std::alloc::{AllocError, Allocator, Layout, System, set_alloc_error_hook};
 use std::collections::VecDeque;
 use std::panic::{AssertUnwindSafe, catch_unwind};
